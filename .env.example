# Copy to .env.local for local development. Never commit real values.
# In production these are set in the hosting provider's environment settings.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Meraki's own project — never a client's) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed to apply migrations from this machine (Settings → Database → Connection string, "URI").
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Email (Resend) ---
# Leave blank in development: emails are logged as "[DEV EMAIL — not sent]" and recorded as dev_skipped.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Meraki Creative <studio@merakicreative.co>" (.co, never .com)
EMAIL_FROM=
# Where new-inquiry alerts go.
STUDIO_NOTIFY_EMAIL=

# --- Payments (Stripe) — unconfigured until keys are added ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Spam protection (optional Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secrets generated by you (any long random string, e.g. `openssl rand -hex 32`) ---
FORM_SIGNING_SECRET=
IP_HASH_SALT=
CRON_SECRET=
